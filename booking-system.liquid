<!--
===========================================================
  SHOPIFY BOOKING WIDGET v6 — WITH 24-HOUR RESTRICTION
  Rendered INSIDE the product form (blocks/buy-buttons.liquid)
===========================================================
  - Add to cart is guarded from the first moment the page loads.
  - Each booking saves a visible date/slot AND hidden machine-readable
    values (_bk_date = YYYY-MM-DD, _bk_slot = morning|evening).
  - Availability comes from the public view `booking_slots` (no customer
    data); live changes arrive through the realtime table `availability_ping`.
===========================================================
-->

<!-- Shopify reads these as order line item properties -->
<input type="hidden" id="bk-date-val"  name="properties[📅 Date]">
<input type="hidden" id="bk-slot-val"  name="properties[⏰ Slot]">
<!-- Hidden (underscore) properties: not shown to customers, used by the checks -->
<input type="hidden" id="bk-date-key"  name="properties[_bk_date]">
<input type="hidden" id="bk-slot-key"  name="properties[_bk_slot]">

<script>
// ============================================================
// EARLY ADD-TO-CART GUARD
// Runs while the page is still loading, before the theme's own
// add-to-cart code. Listens on window (capture) so it always runs
// first: no click, Enter key or sticky button can add this product
// until the booking widget has validated the date and slot.
// ============================================================
(function () {
  if (window.__bkGuardInstalled) return;
  window.__bkGuardInstalled = true;
  window.__bkApproved = false;

  var me = document.currentScript;
  var myForm = me && me.closest ? me.closest('form') : null;
  if (myForm) myForm.classList.add('bk-incomplete');

  function bookingForm() {
    var dv = document.getElementById('bk-date-val');
    return (dv && dv.form) || myForm;
  }

  window.addEventListener('click', function (e) {
    if (window.__bkApproved) return;
    var t = e.target && e.target.closest ? e.target.closest('button, input[type="submit"]') : null;
    if (!t || t.type !== 'submit') return;
    var form = bookingForm();
    if (!form || t.form !== form) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    if (window.__bkRequestAdd) window.__bkRequestAdd(t);
  }, true);

  window.addEventListener('submit', function (e) {
    if (window.__bkApproved) return;
    var form = bookingForm();
    if (!form || e.target !== form) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    if (window.__bkRequestAdd) window.__bkRequestAdd(e.submitter || null);
  }, true);
})();
</script>

