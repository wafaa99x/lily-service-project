<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script>
(function () {
  'use strict';

  var sb = supabase.createClient(BK_SUPABASE_URL, BK_SUPABASE_KEY);
  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  var SLOTS_TABLE = 'booking_slots'; // public view: product_id, booking_date, slot, is_active

  var MAX_BOOKINGS_PER_SLOT = 2;
  // 24 hours (database rule) + 30 minutes safety buffer for the time spent paying
  var MIN_AHEAD_MS = (24 * 60 + 30) * 60 * 1000;
  var SLOTS = {
    morning: { label: 'Morning', time: '6:30 AM – 8:30 AM', icon: '🌅' },
    evening: { label: 'Evening', time: '2:30 PM – 6:30 PM', icon: '🌇' }
  };
  var DOW = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
  var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];

  var state = {
    viewMonth: null,
    selDate: null,
    selSlot: null,
    avail: null,
    showSlots: false,
    productIds: [BK_PRODUCT_ID],
    linkedProductIds: [],
    shopifyProductId: null,
    fullBlockedDates: {},
    fullBookedDates: {},
    checking: false,
    bubbleDismissed: false,
    liveRefreshTimer: null,
    rtChannel: null
  };

  var ready = Promise.resolve();
  var adding = false;

  // Arabic first, English on the next line
  function bi(ar, en) { return ar + '\n' + en; }

  // ─── 24-hour rule helpers (always Kuwait time, UTC+3, whatever the device clock zone) ───
  var KUWAIT_OFFSET_MS = 3 * 60 * 60 * 1000;
  function kuwaitDay(ms) {
    var k = new Date(ms + KUWAIT_OFFSET_MS);
    return new Date(k.getUTCFullYear(), k.getUTCMonth(), k.getUTCDate());
  }

  function getSlotStart(date, slotKey) {
    var hour = slotKey === 'morning' ? 6 : 14;
    // 6:30 / 14:30 in Kuwait on the calendar day shown
    return new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate(), hour, 30, 0, 0) - KUWAIT_OFFSET_MS);
  }

  function isSlotBookable(date, slotKey) {
    return getSlotStart(date, slotKey).getTime() >= Date.now() + MIN_AHEAD_MS;
  }

  function getMinBookableDate() {
    return kuwaitDay(Date.now() + MIN_AHEAD_MS);
  }

  function getMaxBookableDate() {
    var d = kuwaitDay(Date.now());
    d.setMonth(d.getMonth() + 2);
    return d;
  }

  function isDateBookable(date) {
    var maxDate = getMaxBookableDate();
    var compareDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    var compareMax = new Date(maxDate.getFullYear(), maxDate.getMonth(), maxDate.getDate());
    return compareDate <= compareMax && (isSlotBookable(date, 'morning') || isSlotBookable(date, 'evening'));
  }

  function fmt(d) {
    if (!d) return '';
    return d.getFullYear() + '-' +
      String(d.getMonth() + 1).padStart(2, '0') + '-' +
      String(d.getDate()).padStart(2, '0');
  }

  function propDateToYMD(val) {
    var s = String(val || '');
    var iso = s.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return iso[1] + '-' + iso[2] + '-' + iso[3];
    var long = s.match(/(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})/);
    if (long) {
      var mi = MONTHS.map(function (m) { return m.toLowerCase(); }).indexOf(long[2].toLowerCase());
      if (mi !== -1) return long[3] + '-' + String(mi + 1).padStart(2, '0') + '-' + String(+long[1]).padStart(2, '0');
    }
    return s;
  }

  // ─── Product scope ───
  function linkedProductFor(id) {
    for (var i = 0; i < BK_LINKED_PAIRS.length; i++) {
      var pair = BK_LINKED_PAIRS[i];
      if (pair[0] === id) return pair[1];
      if (pair[1] === id) return pair[0];
    }
    return null;
  }

  function uniq(arr) {
    var out = [];
    (arr || []).forEach(function(v) {
      if (!v) return;
      if (out.indexOf(v) === -1) out.push(v);
    });
    return out;
  }

  function inferShopifyProductId() {
    try {
      var id = null;
      if (window.ShopifyAnalytics && window.ShopifyAnalytics.meta && window.ShopifyAnalytics.meta.product) {
        id = window.ShopifyAnalytics.meta.product.id;
      }
      if (!id && window.meta && window.meta.product && window.meta.product.id) {
        id = window.meta.product.id;
      }
      return id ? String(id) : String(BK_PRODUCT_ID);
    } catch (_) {
      return String(BK_PRODUCT_ID);
    }
  }

  function inferProductHandle() {
    try {
      var m = (window.location.pathname || '').match(/\/products\/([^/?#]+)/i);
      return m && m[1] ? decodeURIComponent(m[1]) : null;
    } catch (_) {
      return null;
    }
  }

  async function resolveProductScope() {
    var linkedFallback = linkedProductFor(BK_PRODUCT_ID);
    state.productIds = uniq([BK_PRODUCT_ID]);
    state.linkedProductIds = uniq([linkedFallback]);
    state.shopifyProductId = inferShopifyProductId();

    var shopifyId = state.shopifyProductId;
    var handle = inferProductHandle();

    var r = await sb.from('products')
      .select('id, linked_product_id, shopify_product_id, shopify_handle')
      .eq('is_active', true);

    var rows = r.data || [];
    if (!rows.length) return;

    var matched = rows.filter(function(p) {
      return p.id === BK_PRODUCT_ID
        || (shopifyId && p.shopify_product_id && String(p.shopify_product_id) === shopifyId)
        || (handle && p.shopify_handle && String(p.shopify_handle).toLowerCase() === handle.toLowerCase());
    });

    if (!matched.length) return;

    var base = matched.find(function(p) { return shopifyId && p.shopify_product_id && String(p.shopify_product_id) === shopifyId; }) ||
      matched.find(function(p) { return handle && p.shopify_handle && String(p.shopify_handle).toLowerCase() === handle.toLowerCase(); }) ||
      matched[0];

    var linkedIds = [linkedFallback];
    if (base && base.linked_product_id) linkedIds.push(base.linked_product_id);

    state.productIds = uniq([base.id, BK_PRODUCT_ID]);
    state.linkedProductIds = uniq(linkedIds);
  }

  async function loadFullBlockedDates() {
    var min = fmt(getMinBookableDate());
    var max = fmt(getMaxBookableDate());
    var r = await sb.from('blocked_slots')
      .select('block_date, slot, product_id')
      .gte('block_date', min)
      .lte('block_date', max);

    var grouped = {};
    var productIds = state.productIds;
    (r.data || []).forEach(function(b) {
      if (b.product_id && productIds.indexOf(b.product_id) === -1) return;
      var day = b.block_date;
      if (!grouped[day]) grouped[day] = { all: false, morning: false, evening: false };
      if (!b.slot || b.slot === 'all') grouped[day].all = true;
      if (b.slot === 'morning') grouped[day].morning = true;
      if (b.slot === 'evening') grouped[day].evening = true;
    });

    var full = {};
    Object.keys(grouped).forEach(function(d) {
      var g = grouped[d];
      if (g.all || (g.morning && g.evening)) full[d] = true;
    });
    state.fullBlockedDates = full;
  }

  async function loadFullBookedDates() {
    var min = fmt(getMinBookableDate());
    var max = fmt(getMaxBookableDate());
    var r = await sb.from(SLOTS_TABLE)
      .select('booking_date, slot, product_id')
      .eq('is_active', true)
      .gte('booking_date', min)
      .lte('booking_date', max);

    var grouped = {};
    (r.data || []).forEach(function(b) {
      if (!b || !b.booking_date || !b.slot) return;
      var day = b.booking_date;
      if (!grouped[day]) grouped[day] = { morning: 0, evening: 0 };
      if (b.slot === 'morning') grouped[day].morning += 1;
      if (b.slot === 'evening') grouped[day].evening += 1;
    });

    var full = {};
    Object.keys(grouped).forEach(function(d) {
      var g = grouped[d];
      if (g.morning >= MAX_BOOKINGS_PER_SLOT && g.evening >= MAX_BOOKINGS_PER_SLOT) full[d] = true;
    });
    state.fullBookedDates = full;
  }

  async function loadSlotCounts(dateStr) {
    var counts = { morning: 0, evening: 0 };
    var mine = { morning: false, evening: false };
    var r = await sb.from(SLOTS_TABLE)
      .select('slot, product_id')
      .eq('is_active', true)
      .eq('booking_date', dateStr);

    var productIds = state.productIds;
    (r.data || []).forEach(function(b) {
      if (!b || !b.slot) return;
      if (b.slot === 'morning') counts.morning += 1;
      if (b.slot === 'evening') counts.evening += 1;
      if (productIds.indexOf(b.product_id) !== -1) mine[b.slot] = true;
    });

    return { counts: counts, mine: mine };
  }

  // Bookings already in this customer's cart for one date (not booked yet,
  // but they must still count: same package, paired stand, 2 places per slot)
  function cartSlotOf(props) {
    var pDate = props._bk_date || null;
    var pSlot = props._bk_slot || '';
    if (!pDate || !pSlot) {
      Object.keys(props).forEach(function(k) {
        if (k.charAt(0) === '_') return;
        if (!pDate && k.toLowerCase().includes('date')) pDate = props[k];
        if (!pSlot && k.toLowerCase().includes('slot')) pSlot = props[k];
      });
    }
    if (!pDate || !pSlot) return null;
    var s = String(pSlot).toLowerCase();
    var slot = (s.indexOf('evening') !== -1 || s.indexOf('pm') !== -1) ? 'evening' : 'morning';
    return { date: propDateToYMD(pDate), slot: slot };
  }

  function placeKey(shopifyId) {
    var other = linkedProductFor(shopifyId);
    return other && other < shopifyId ? other : shopifyId;
  }

  async function loadCartUsage(dateStr) {
    var use = {
      morning: { places: 0, mine: false, linked: false },
      evening: { places: 0, mine: false, linked: false }
    };
    try {
      var resp = await fetch(ROOT + 'cart.js', { cache: 'no-store', headers: { Accept: 'application/json' } });
      if (!resp.ok) return use;
      var cart = await resp.json();
      var myId = state.shopifyProductId || String(BK_PRODUCT_ID);
      var myLinked = linkedProductFor(myId);
      var seen = { morning: {}, evening: {} };
      ((cart && cart.items) || []).forEach(function(it) {
        if (!it || !it.properties) return;
        var b = cartSlotOf(it.properties);
        if (!b || b.date !== dateStr) return;
        var id = String(it.product_id);
        var u = use[b.slot];
        if (id === myId) u.mine = true;
        if (myLinked && id === myLinked) u.linked = true;
        var key = placeKey(id);
        if (!seen[b.slot][key]) { seen[b.slot][key] = true; u.places += 1; }
      });
    } catch (_) {}
    return use;
  }

  async function checkAvail(dateStr) {
    var cartUse = await loadCartUsage(dateStr);
    var counts = await loadSlotCounts(dateStr);
    var taken = { morning: false, evening: false };

    var productIds = state.productIds;
    var linkedIds = state.linkedProductIds && state.linkedProductIds.length
      ? state.linkedProductIds
      : uniq([linkedProductFor(BK_PRODUCT_ID)]);

    if (linkedIds.length) {
      var r2 = await sb.from(SLOTS_TABLE)
        .select('slot')
        .eq('is_active', true)
        .in('product_id', linkedIds)
        .eq('booking_date', dateStr);
      (r2.data || []).forEach(function(b) { taken[b.slot] = true; });
    }

    var r3 = await sb.from('blocked_slots')
      .select('slot, product_id')
      .eq('block_date', dateStr);
    (r3.data || []).forEach(function(b) {
      if (!b.product_id || productIds.indexOf(b.product_id) !== -1) {
        if (!b.slot || b.slot === 'all') {
          taken.morning = true;
          taken.evening = true;
        } else {
          taken[b.slot] = true;
        }
      }
    });

    function free(slot) {
      var c = cartUse[slot];
      return !taken[slot] && !counts.mine[slot] && !c.mine && !c.linked &&
        counts.counts[slot] + c.places < MAX_BOOKINGS_PER_SLOT;
    }

    return {
      morning: free('morning'),
      evening: free('evening'),
      counts: counts.counts,
      mine: counts.mine,
      cart: cartUse
    };
  }

  async function checkCartForConflict(dateStr, slotKey) {
    try {
      var resp = await fetch(ROOT + 'cart.js', { cache: 'no-store', headers: { Accept: 'application/json' } });
      if (!resp.ok) return null;
      var cart = await resp.json();
      var items = (cart && cart.items) || [];
      var targetId = state.shopifyProductId || String(BK_PRODUCT_ID);

      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        if (String(it.product_id) !== targetId || !it.properties) continue;
        var props = it.properties;
        var pDate = props._bk_date || null;
        var pSlot = props._bk_slot || '';
        if (!pDate || !pSlot) {
          Object.keys(props).forEach(function(k) {
            if (k.charAt(0) === '_') return;
            if (!pDate && k.toLowerCase().includes('date')) pDate = props[k];
            if (!pSlot && k.toLowerCase().includes('slot')) pSlot = props[k];
          });
        }
        if (!pDate) continue;
        var s = String(pSlot).toLowerCase();
        var cartSlot = (s.indexOf('evening') !== -1 || s.indexOf('pm') !== -1) ? 'evening' : 'morning';
        if (propDateToYMD(pDate) === dateStr && cartSlot === slotKey) return true;
      }
      return false;
    } catch (_) {
      return null;
    }
  }

  async function refreshLiveAvailability() {
    await Promise.all([loadFullBlockedDates(), loadFullBookedDates()]);
    if (state.selDate) {
      state.avail = await checkAvail(fmt(state.selDate));
      if (state.selSlot && state.avail[state.selSlot] === false) state.selSlot = null;
    }
    render();
  }

  async function refreshSelectedDateOnly() {
    if (!state.selDate || adding) return;
    state.avail = await checkAvail(fmt(state.selDate));
    if (state.selSlot && state.avail[state.selSlot] === false) state.selSlot = null;
    render();
  }

  function startLiveRefresh() {
    if (state.liveRefreshTimer) clearInterval(state.liveRefreshTimer);
    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'visible') refreshLiveAvailability().catch(function() {});
    });
    state.liveRefreshTimer = setInterval(function() {
      if (document.visibilityState === 'visible') refreshSelectedDateOnly().catch(function() {});
    }, 5000);
    try {
      // One-row table bumped by the database whenever bookings or blocked slots change
      state.rtChannel = sb
        .channel('bk-widget-live-' + Math.random().toString(36).slice(2, 8))
        .on('postgres_changes', { event: '*', schema: 'public', table: 'availability_ping' }, function() {
          refreshLiveAvailability().catch(function() {});
        })
        .subscribe();
    } catch (e) {
      console.warn('[bk-widget] realtime unavailable:', e);
    }
  }

  // ─── Render ───
  function render() {
    var root = document.getElementById('bk-widget');
    if (!root) return;
    var prevErr = document.getElementById('bk-err');
    var keepErr = prevErr && prevErr.classList.contains('show') ? prevErr.textContent : '';

    root.innerHTML =
      renderCalCard() +
      (state.showSlots ? renderSlotCard() : '') +
      renderSummary() +
      '<div id="bk-err" role="alert"></div>';

    if (keepErr) {
      var e = document.getElementById('bk-err');
      e.textContent = keepErr;
      e.classList.add('show');
    }

    bindCal();
    bindSlots();
    syncHiddenInputs();
    syncSummary();
    syncAvailBubble();
  }

  function renderCalCard() {
    var vm = state.viewMonth;
    var minDate = getMinBookableDate();
    var maxDate = getMaxBookableDate();

    var firstDay = new Date(vm.getFullYear(), vm.getMonth(), 1);
    var lastDay = new Date(vm.getFullYear(), vm.getMonth() + 1, 0);

    var prevFirst = new Date(vm.getFullYear(), vm.getMonth() - 1, 1);
    var nextFirst = new Date(vm.getFullYear(), vm.getMonth() + 1, 1);
    var canPrev = prevFirst >= new Date(minDate.getFullYear(), minDate.getMonth(), 1);
    var canNext = nextFirst <= new Date(maxDate.getFullYear(), maxDate.getMonth(), 1);

    var done = !!state.selDate;
    var head = '<div class="bk-card-head">' +
      '<div class="bk-step-num' + (done ? ' done' : '') + '">' + (done ? '✓' : '1') + '</div>' +
      '<h4>Select Delivery Date</h4></div>';

    var grid = '<div class="bk-grid">';
    DOW.forEach(function(d) { grid += '<div class="bk-dow">' + d + '</div>'; });
    for (var b = 0; b < firstDay.getDay(); b++) grid += '<div class="bk-day bk-empty"></div>';

    for (var d = 1; d <= lastDay.getDate(); d++) {
      var date = new Date(vm.getFullYear(), vm.getMonth(), d);
      var dStr = fmt(date);
      var off = !isDateBookable(date) || !!state.fullBlockedDates[dStr] || !!state.fullBookedDates[dStr];
      var isSel = state.selDate && fmt(state.selDate) === dStr;
      grid += '<div class="bk-day' + (off ? ' bk-off' : '') + (isSel ? ' bk-sel' : '') + '" data-d="' + dStr + '">' + d + '</div>';
    }
    grid += '</div>';

    return '<div class="bk-card">' + head +
      '<div class="bk-cal-wrap">' +
      '<div class="bk-cal-nav">' +
      '<button type="button" id="bk-prev" ' + (canPrev ? '' : 'disabled') + '>&#8249;</button>' +
      '<span class="bk-cal-title">' + MONTHS[vm.getMonth()] + ' ' + vm.getFullYear() + '</span>' +
      '<button type="button" id="bk-next" ' + (canNext ? '' : 'disabled') + '>&#8250;</button>' +
      '</div>' + grid + '</div></div>';
  }

  function renderSlotCard() {
    var done = !!state.selSlot;
    var head = '<div class="bk-card-head">' +
      '<div class="bk-step-num' + (done ? ' done' : '') + '">' + (done ? '✓' : '2') + '</div>' +
      '<h4>Select Time Slot</h4></div>';

    var body;
    if (!state.selDate) {
      body = '<div class="bk-slots-ph">← Pick a date first</div>';
    } else if (state.checking) {
      body = '<div class="bk-slots-ph"><span class="bk-spin"></span>Checking availability…</div>';
    } else {
      body = '<div class="bk-slots">';
      ['morning', 'evening'].forEach(function(key) {
        var info = SLOTS[key];
        var avail = state.avail ? state.avail[key] : null;
        var bookedCount = state.avail && state.avail.counts ? state.avail.counts[key] : null;
        var alreadyBooked = state.avail && state.avail.mine ? !!state.avail.mine[key] : false;
        var cartUse = state.avail && state.avail.cart ? state.avail.cart[key] : null;
        var tooSoon = state.selDate ? !isSlotBookable(state.selDate, key) : false;
        var isSel = state.selSlot === key;
        var isNa = avail === false || tooSoon;
        var stTxt, stCls;
        var inCart = cartUse ? cartUse.places : 0;
        if (avail === null) { stTxt = bi('جارٍ التحقق…', 'Checking…'); stCls = 'bk-st-chk'; }
        else if (alreadyBooked) { stTxt = bi('محجوز لهذا المنتج', 'Already booked'); stCls = 'bk-st-na'; }
        else if (cartUse && cartUse.mine) { stTxt = bi('موجود في سلتك', 'Already in your cart'); stCls = 'bk-st-na'; }
        else if (cartUse && cartUse.linked) { stTxt = bi('الستاند المرتبط في سلتك', 'Paired stand in your cart'); stCls = 'bk-st-na'; }
        else if (avail && !tooSoon) {
          stTxt = bookedCount !== null
            ? bi('محجوز ' + bookedCount + ' من ' + MAX_BOOKINGS_PER_SLOT, bookedCount + '/' + MAX_BOOKINGS_PER_SLOT + ' booked') +
              (inCart ? '\n' + bi('في سلتك: ' + inCart, 'In your cart: ' + inCart) : '')
            : bi('متاح', 'Available');
          stCls = 'bk-st-ok';
        }
        else if (bookedCount !== null && bookedCount >= MAX_BOOKINGS_PER_SLOT) { stTxt = bi('مكتمل', 'Fully booked'); stCls = 'bk-st-na'; }
        else if (bookedCount !== null && bookedCount + inCart >= MAX_BOOKINGS_PER_SLOT) { stTxt = bi('مكتمل مع ما في سلتك', 'Full with your cart'); stCls = 'bk-st-na'; }
        else { stTxt = bi('غير متاح', 'Unavailable'); stCls = 'bk-st-na'; }
        body +=
          '<div class="bk-slot' + (isSel ? ' bk-slot-sel' : '') + (isNa ? ' bk-slot-na' : '') +
          '" data-slot="' + key + '"' + (isNa ? ' tabindex="-1"' : '') + '>' +
          '<div class="bk-slot-ico">' + info.icon + '</div>' +
          '<span class="bk-slot-lbl">' + info.label + '</span>' +
          '<span class="bk-slot-time">' + info.time + '</span>' +
          '<span class="bk-slot-st ' + stCls + '">' + stTxt + '</span>' +
          '</div>';
      });
      body += '</div>';
    }
    return '<div class="bk-card">' + head + body +
      '<div class="bk-delivery-note">ملاحظة: الفترة المختارة هي فترة التوصيل وليست فترة الخدمة.</div>' +
      '</div>';
  }

  function syncAvailBubble() {
    var show = state.selDate && !state.selSlot && !state.bubbleDismissed;
    var el = document.getElementById('bk-avail-float');
    if (!show) {
      if (el && el.parentNode) el.parentNode.removeChild(el);
      return;
    }
    if (el) return;
    el = document.createElement('div');
    el.id = 'bk-avail-float';
    el.className = 'bk-avail-float';
    el.setAttribute('role', 'status');
    el.innerHTML =
      '<button type="button" class="bk-avail-float-close" aria-label="إغلاق">✕</button>' +
      '<span>لم تجد الوقت المناسب؟ تواصل معنا عبر الواتساب، وقد نتمكن من توفيره لك.</span>';
    el.querySelector('.bk-avail-float-close').addEventListener('click', function() {
      state.bubbleDismissed = true;
      syncAvailBubble();
    });
    document.body.appendChild(el);
  }

  function renderSummary() {
    return '<div id="bk-summary">' +
      '<div class="bk-sum-item"><div class="bk-sum-lbl">Date</div><div class="bk-sum-val" id="bk-sv-date">—</div></div>' +
      '<div class="bk-sum-item"><div class="bk-sum-lbl">Slot</div><div class="bk-sum-val" id="bk-sv-slot">—</div></div>' +
      '</div>';
  }

  function bindCal() {
    var prev = document.getElementById('bk-prev');
    var next = document.getElementById('bk-next');
    if (prev) prev.addEventListener('click', function() {
      state.viewMonth = new Date(state.viewMonth.getFullYear(), state.viewMonth.getMonth() - 1, 1);
      render();
    });
    if (next) next.addEventListener('click', function() {
      state.viewMonth = new Date(state.viewMonth.getFullYear(), state.viewMonth.getMonth() + 1, 1);
      render();
    });

    document.querySelectorAll('.bk-day:not(.bk-off):not(.bk-empty)').forEach(function(el) {
      el.addEventListener('click', async function() {
        var parts = el.dataset.d.split('-');
        var selectedDate = new Date(+parts[0], +parts[1] - 1, +parts[2]);
        if (!isDateBookable(selectedDate)) {
          showErr(bi('هذا التاريخ غير متاح للحجز. يرجى اختيار موعد بعد ٢٤ ساعة على الأقل.', 'This date is not available for booking. Please select a date at least 24 hours from now.'));
          return;
        }
        clearErr();
        state.selDate = selectedDate;
        state.selSlot = null;
        state.avail = null;
        state.showSlots = true;
        state.checking = true;
        state.bubbleDismissed = false;
        render();
        try {
          await ready;
          var pre = await checkAvail(el.dataset.d);
          state.avail = pre;
          state.avail.morning = state.avail.morning && isSlotBookable(selectedDate, 'morning');
          state.avail.evening = state.avail.evening && isSlotBookable(selectedDate, 'evening');
        } catch (e) {
          state.avail = null;
        }
        state.checking = false;
        render();
      });
    });
  }

  function bindSlots() {
    document.querySelectorAll('.bk-slot:not(.bk-slot-na)').forEach(function(el) {
      el.addEventListener('click', function() {
        state.selSlot = el.dataset.slot;
        clearErr();
        render();
      });
    });
  }

  function syncHiddenInputs() {
    var dv = document.getElementById('bk-date-val');
    var sv = document.getElementById('bk-slot-val');
    var dk = document.getElementById('bk-date-key');
    var sk = document.getElementById('bk-slot-key');

    if (dv) dv.value = state.selDate ?
      state.selDate.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '';
    if (sv) sv.value = state.selSlot ? SLOTS[state.selSlot].label + ' (' + SLOTS[state.selSlot].time + ')' : '';
    if (dk) dk.value = state.selDate ? fmt(state.selDate) : '';
    if (sk) sk.value = state.selSlot || '';
    syncAddToCartState();
  }

  function syncSummary() {
    var el = document.getElementById('bk-summary');
    if (!el) return;
    if (state.selDate || state.selSlot) {
      el.classList.add('show');
      var sd = document.getElementById('bk-sv-date');
      var ss = document.getElementById('bk-sv-slot');
      if (sd) sd.textContent = state.selDate ?
        state.selDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      if (ss) ss.textContent = state.selSlot ? SLOTS[state.selSlot].label : '—';
    } else {
      el.classList.remove('show');
    }
  }

  function showErr(msg, scroll) {
    var el = document.getElementById('bk-err');
    if (!el) return;
    el.textContent = '⚠ ' + msg;
    el.classList.add('show');
    el.classList.remove('bk-flash');
    void el.offsetWidth;
    el.classList.add('bk-flash');
    if (scroll) {
      var w = document.getElementById('bk-widget');
      if (w && w.scrollIntoView) w.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function clearErr() {
    var el = document.getElementById('bk-err');
    if (el) {
      el.classList.remove('show');
      el.classList.remove('bk-flash');
      el.textContent = '';
    }
  }

  function bookingForm() {
    var dv = document.getElementById('bk-date-val');
    return dv ? dv.form : null;
  }

  function hasBookingValues() {
    var date = document.getElementById('bk-date-key');
    var slot = document.getElementById('bk-slot-key');
    return !!(date && date.value.trim() && slot && slot.value.trim());
  }

  function syncAddToCartState() {
    var form = bookingForm();
    if (!form) return;
    form.classList.toggle('bk-incomplete', !hasBookingValues());
  }

  // Bookable products are always added with quantity 1
  function enforceQuantity(form) {
    var qty = form.querySelector('input[name="quantity"]');
    if (qty && Number(qty.value) !== 1) {
      qty.value = '1';
      qty.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  function waitForCartAdd(timeoutMs) {
    return new Promise(function (resolve) {
      var done = false;
      function onUpdate(e) {
        var d = (e.detail && e.detail.data) || {};
        if (d.source !== 'product-form-component') return;
        finish(!d.didError);
      }
      function finish(ok) {
        if (done) return;
        done = true;
        document.removeEventListener('cart:update', onUpdate);
        clearTimeout(timer);
        resolve(ok);
      }
      var timer = setTimeout(function () { finish(null); }, timeoutMs);
      document.addEventListener('cart:update', onUpdate);
    });
  }

  async function requestAdd(submitter) {
    if (adding) return;
    var form = bookingForm();
    if (!form) return;
    var btn = (submitter && submitter.form === form) ? submitter :
      (form.querySelector('[ref="addToCartButton"]') || form.querySelector('button[type="submit"]'));
    if (btn && btn.disabled) return;

    if (!state.selDate) { showErr(bi('يرجى اختيار تاريخ التوصيل.', 'Please select a delivery date.'), true); return; }
    if (!state.selSlot) { showErr(bi('يرجى اختيار فترة التوصيل.', 'Please select a time slot.'), true); return; }
    if (!isDateBookable(state.selDate) || !isSlotBookable(state.selDate, state.selSlot)) {
      showErr(bi('هذا التاريخ لم يعد متاحاً للحجز. يرجى اختيار تاريخ آخر.', 'This date is no longer available for booking. Please choose another date.'), true);
      return;
    }

    adding = true;
    form.classList.add('bk-busy');
    clearErr();

    try {
      await ready;

      state.checking = true;
      render();
      var avail = null;
      try { avail = await checkAvail(fmt(state.selDate)); } catch (_) { avail = null; }
      state.checking = false;
      if (avail) {
        avail.morning = avail.morning && isSlotBookable(state.selDate, 'morning');
        avail.evening = avail.evening && isSlotBookable(state.selDate, 'evening');
        state.avail = avail;
      }
      render();

      if (!avail) { showErr(bi('تعذر التحقق من التوفر. يرجى المحاولة مرة أخرى.', 'Could not check availability. Please try again.'), true); return; }
      if (avail[state.selSlot] === false) {
        var cu = avail.cart ? avail.cart[state.selSlot] : null;
        if (avail.mine && avail.mine[state.selSlot]) {
          showErr(bi('هذا المنتج محجوز بالفعل في هذه الفترة. يرجى اختيار وقت آخر.', 'This product is already booked for this slot. Please choose another time.'), true);
        } else if (cu && cu.mine) {
          showErr(bi('هذا المنتج موجود في سلتك لنفس التاريخ والفترة. يرجى اختيار وقت آخر.', 'This product is already in your cart for this date and slot. Please choose another time.'), true);
        } else if (cu && cu.linked) {
          showErr(bi('الستاند المرتبط بهذا المنتج موجود في سلتك لنفس التاريخ والفترة، ولا يمكن حجزهما معاً. يرجى اختيار وقت آخر.', 'The paired stand is already in your cart for this date and slot, and both cannot be booked together. Please choose another time.'), true);
        } else if (avail.counts && avail.counts[state.selSlot] >= MAX_BOOKINGS_PER_SLOT) {
          showErr(bi('اكتملت الحجوزات في هذه الفترة (حجزان كحد أقصى). يرجى اختيار وقت آخر.', 'That slot has reached the daily capacity of 2 bookings. Please choose another time.'), true);
        } else if (cu && avail.counts && avail.counts[state.selSlot] + cu.places >= MAX_BOOKINGS_PER_SLOT) {
          showErr(bi('لا يوجد مكان متبقٍ في هذه الفترة بعد احتساب الحجوزات الموجودة في سلتك. يرجى اختيار وقت آخر.', 'No place is left in this slot once the bookings already in your cart are counted. Please choose another time.'), true);
        } else {
          showErr(bi('هذه الفترة غير متاحة لهذا المنتج في التاريخ المختار. يرجى اختيار وقت آخر.', 'That slot is not available for this product on the selected date. Please choose another time.'), true);
        }
        return;
      }

      var dateStr = fmt(state.selDate);
      var slotKey = state.selSlot;
      var cartConflict = await checkCartForConflict(dateStr, slotKey);
      if (cartConflict === true) {
        showErr(bi('هذا المنتج موجود في سلتك لنفس التاريخ والفترة. يرجى اختيار وقت آخر.', 'This product is already in your cart for this date and slot. Please choose another time.'), true);
        return;
      }

      syncHiddenInputs();
      if (!hasBookingValues()) { showErr(bi('يرجى اختيار تاريخ وفترة التوصيل.', 'Please select a delivery date and time slot.'), true); return; }
      enforceQuantity(form);

      var waiter = waitForCartAdd(10000);
      window.__bkApproved = true;
      try {
        if (btn && !btn.disabled) btn.click();
        else if (form.requestSubmit) form.requestSubmit();
      } finally {
        window.__bkApproved = false;
      }

      var ok = await waiter;
      if (ok === false) { showErr(bi('تعذرت الإضافة إلى السلة. يرجى المحاولة مرة أخرى.', 'Could not add to cart. Please try again.'), true); return; }
      if (ok === null) {
        var inCart = await checkCartForConflict(dateStr, slotKey);
        if (inCart !== true) { showErr(bi('تعذر التأكد من إضافة المنتج إلى السلة. يرجى المحاولة مرة أخرى.', 'Could not confirm the item was added. Please try again.'), true); return; }
      }

      window.location.href = ROOT + 'cart';
    } finally {
      adding = false;
      form.classList.remove('bk-busy');
    }
  }

  window.__bkRequestAdd = function (submitter) {
    requestAdd(submitter).catch(function (err) {
      console.error('[bk-widget] add to cart failed:', err);
      showErr(bi('حدث خطأ. يرجى المحاولة مرة أخرى.', 'Something went wrong. Please try again.'), true);
    });
  };

  document.addEventListener('variant:update', function () {
    setTimeout(syncAddToCartState, 0);
  });

  async function init() {
    var minDate = getMinBookableDate();
    state.viewMonth = new Date(minDate.getFullYear(), minDate.getMonth(), 1);
    render();
    ready = resolveProductScope().catch(function () {});
    await ready;
    await Promise.all([loadFullBlockedDates(), loadFullBookedDates()]).catch(function () {});
    render();
    startLiveRefresh();
  }

  syncAddToCartState();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
{%- endunless -%}
